# Copie para .env.local e preencha. Nunca versione segredos.

# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp do corretor: só dígitos, com DDI+DDD (ex.: 5548999999999)
NEXT_PUBLIC_WHATSAPP=

# Mostrar imóveis/lançamentos de exemplo (isDemo). Use "false" em produção
NEXT_PUBLIC_SHOW_DEMO=true

# Webhook que recebe os leads (n8n, CRM...). Só no servidor. Fase 4
LEAD_WEBHOOK_URL=

# Analytics: sem ID, nada é carregado. Só rodam após consentimento. Fase 5
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
